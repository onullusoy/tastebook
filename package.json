{
  "name": "tastebook-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --only-local",
    "local:down": "docker compose -f docker-compose.yml down",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @tastebook/db generate",
    "db:migrate": "pnpm --filter @tastebook/db migrate",
    "db:push": "pnpm --filter @tastebook/db push",
    "db:studio": "pnpm --filter @tastebook/db studio"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "overrides": {
    "fastify": "5.8.5"
  }
}
