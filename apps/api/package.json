{
  "name": "@tastebook/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "optimize-legacy": "node --env-file=../../.env --import tsx src/scripts/optimize-legacy-images.ts",
    "backfill-addresses": "node --env-file=../../.env --import tsx src/scripts/backfill-formatted-addresses.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.588.0",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.0",
    "@tastebook/db": "workspace:*",
    "@tastebook/shared": "workspace:*",
    "argon2": "^0.40.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.4.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.0"
  }
}
